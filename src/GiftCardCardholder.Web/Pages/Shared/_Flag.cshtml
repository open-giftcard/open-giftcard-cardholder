@model string
@*
  Hand-drawn rather than emoji: Windows ships no glyphs for regional-indicator
  flag pairs, so the emoji would render as two grey letters on the machines this
  demo runs on. Decorative only, since the button already carries the language
  name as text.
*@
@if (Model == "tr")
{
  <svg class="flag" viewBox="0 0 24 16" aria-hidden="true" focusable="false">
    <rect width="24" height="16" fill="#e30a17" />
    <circle cx="9" cy="8" r="4" fill="#ffffff" />
    <circle cx="10.4" cy="8" r="3.2" fill="#e30a17" />
    <path fill="#ffffff"
          d="M15.30 5.10 L15.98 7.06 L18.06 7.10 L16.40 8.36 L17.00 10.35 L15.30 9.16 L13.60 10.35 L14.20 8.36 L12.54 7.10 L14.62 7.06 Z" />
  </svg>
}
else
{
  <svg class="flag" viewBox="0 0 24 16" aria-hidden="true" focusable="false">
    <clipPath id="flag-gb-clip">
      <rect width="24" height="16" />
    </clipPath>
    <g clip-path="url(#flag-gb-clip)">
      <rect width="24" height="16" fill="#012169" />
      <path d="M0 0 L24 16 M24 0 L0 16" stroke="#ffffff" stroke-width="3.2" />
      <path d="M0 0 L24 16 M24 0 L0 16" stroke="#c8102e" stroke-width="1.6" />
      <path d="M12 0 V16 M0 8 H24" stroke="#ffffff" stroke-width="5.2" />
      <path d="M12 0 V16 M0 8 H24" stroke="#c8102e" stroke-width="3.1" />
    </g>
  </svg>
}
