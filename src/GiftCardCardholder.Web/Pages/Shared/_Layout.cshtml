@using System.Globalization
@using GiftCardCardholder.Web.Configuration
@using Microsoft.Extensions.Options
@inject IOptions<CardholderUiOptions> UiOptions
@{
  var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
  var currentLanguage = CardholderLanguages.FindOrDefault(culture);
  culture = currentLanguage.CultureName;
  var returnUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
  var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
  var javascriptEnhancementsEnabled = UiOptions.Value.EnableJavaScriptEnhancements;

  @* The theme is stamped server-side so it works before any optional script and
     remains complete in HTML-only mode. "system" is stamped rather than omitted
     so the attribute always says which of the three states is in force. *@
  var theme = Context.Request.Cookies["giftcard_theme"];
  if (theme is not "light" and not "dark")
  {
    theme = "system";
  }
}
<!DOCTYPE html>
<html lang="@culture" data-theme="@theme"
      data-enhancements="@(javascriptEnhancementsEnabled ? "enabled" : "disabled")">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>@ViewData["Title"] — Open Giftcard</title>
  <link rel="stylesheet" href="~/css/app.css" />
  <link rel="icon" href="~/logo.svg" type="image/svg+xml" />
</head>
<body>
  <a class="skip-link" href="#main">@Text["Skip to content"]</a>
  <header class="app-header">
    @* The mark is the way home, which is what people expect of a logo. *@
    <a class="brand" asp-page="/Cards" aria-label="@Text["My cards"]">
      <img class="brand-logo" src="~/logo.svg" alt="Open Giftcard" width="52" height="20" />
      <span class="brand-muted">Open Giftcard</span>
    </a>
    @*
      Collapsed to the current setting, opening onto the other two. <details>
      remains the control in both modes because it supplies keyboard and
      screen-reader state without depending on the optional enhancement module.
    *@
    <div class="settings">
      <details class="menu">
        <summary class="chip" title="@Text["Appearance"]">
          @if (theme == "light")
          {
            <partial name="_ThemeIcon" model="@("light")" />
          }
          else if (theme == "dark")
          {
            <partial name="_ThemeIcon" model="@("dark")" />
          }
          else
          {
            <partial name="_ThemeIcon" model="@("system")" />
          }
          <span class="visually-hidden">@Text["Appearance"]</span>
        </summary>
        <form method="post" asp-page="/Theme" class="menu__panel" aria-label="@Text["Appearance"]">
          <input type="hidden" name="returnUrl" value="@returnUrl" />
          <button type="submit" name="theme" value="light"
                  class="menu__item @(theme == "light" ? "menu__item--on" : "")">
            <partial name="_ThemeIcon" model="@("light")" />
            <span>@Text["Light"]</span>
          </button>
          <button type="submit" name="theme" value="dark"
                  class="menu__item @(theme == "dark" ? "menu__item--on" : "")">
            <partial name="_ThemeIcon" model="@("dark")" />
            <span>@Text["Dark"]</span>
          </button>
          <button type="submit" name="theme" value="system"
                  class="menu__item @(theme == "system" ? "menu__item--on" : "")">
            <partial name="_ThemeIcon" model="@("system")" />
            <span>@Text["Match my device"]</span>
          </button>
        </form>
      </details>

      @* English remains the first/default catalogue entry, but this is a real
         menu rather than a two-language toggle. Adding a catalogue entry and a
         resource file automatically adds another choice. *@
      <details class="menu language-menu">
        <summary class="chip chip--language" title="@Text["Language"]">
          <partial name="_LanguageIcon" />
          <span lang="@currentLanguage.CultureName">@currentLanguage.NativeName</span>
          <span class="visually-hidden">@Text["Language"]</span>
        </summary>
        <form method="post" asp-page="/Language" class="menu__panel"
              aria-label="@Text["Language"]">
          <input type="hidden" name="returnUrl" value="@returnUrl" />
          @foreach (var language in CardholderLanguages.All)
          {
            var isCurrentLanguage = language.CultureName == currentLanguage.CultureName;
            <button type="submit" name="culture" value="@language.CultureName"
                    class="menu__item @(isCurrentLanguage ? "menu__item--on" : "")"
                    aria-pressed="@(isCurrentLanguage ? "true" : "false")">
              <partial name="_LanguageIcon" />
              <span lang="@language.CultureName">@language.NativeName</span>
              @if (isCurrentLanguage)
              {
                <span class="visually-hidden">— @Text["Current language"]</span>
              }
            </button>
          }
        </form>
      </details>
    </div>
    @if (ViewData["ShowSignOut"] is true)
    {
      <nav class="header-nav" aria-label="@Text["Account navigation"]">
        <a asp-page="/Cards" class="nav-btn @(currentPage == "/Cards" ? "nav-btn--active" : "")">@Text["My cards"]</a>
        <a asp-page="/Shares" class="nav-btn @(currentPage == "/Shares" ? "nav-btn--active" : "")">@Text["Sharing"]</a>
      </nav>
      <form method="post" asp-page="/SignOut" class="header-form">
        <button type="submit" class="signout-btn">@Text["Sign out"]</button>
      </form>
    }
  </header>

  <main id="main" class="app-main" tabindex="-1">
    @RenderBody()
  </main>

  <footer class="app-footer">
    <p>@Text["Your gift card balance is held by the platform. Keep your activation link private."]</p>
  </footer>
  @if (javascriptEnhancementsEnabled)
  {
    <script type="module" src="~/js/enhancements.js" asp-append-version="true"></script>
  }
</body>
</html>
