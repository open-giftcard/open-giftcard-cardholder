@page "/share/claim/confirm"
@model ShareClaimConfirmModel
@{
  ViewData["Title"] = Text["Claim shared value"];
}

<h1>@Text["Claim shared value"]</h1>
<p class="lead">@Text["The sender should have given you a six-digit PIN separately from this link."]</p>

@if (Model.ErrorMessage is not null)
{
  <div class="alert alert-error" role="alert">@Model.ErrorMessage</div>
}

@if (Model.HasActivation && Model.NeedsSignIn)
{
  <section class="panel">
    <h2>@Text["Sign in first"]</h2>
    <p>@Text["Protected shares can only be added to an existing gift card account."]</p>
    <a class="button" asp-page="/SignIn" asp-route-ReturnUrl="/share/claim/confirm">@Text["Sign in to continue"]</a>
  </section>
}
else if (Model.HasActivation)
{
  <form method="post" class="panel">
    <div class="field">
      <label asp-for="Pin">@Text["Six-digit PIN"]</label>
      <input asp-for="Pin" type="text" inputmode="numeric" autocomplete="one-time-code"
             minlength="6" maxlength="6" pattern="[0-9]{6}" required />
    </div>
    <button type="submit" class="button">@Text["Claim shared value"]</button>
  </form>
}
