@page "/activate/password"
@model ActivatePasswordModel
@{
    ViewData["Title"] = Text["Create your password"];
}

@if (!Model.HasActivation)
{
  <h1>@Text["We could not activate this card"]</h1>
  <div class="alert alert-error" role="alert">@Model.ErrorMessage</div>
  <a class="button button-secondary" asp-page="/SignIn">@Text["Sign in instead"]</a>
}
else
{
  <h1>@Text["Create your password"]</h1>
  <p class="lead">
    @Text["This is your first gift card, so choose a password to protect your account. You will use it with the email address or phone number your card was sent to."]
  </p>

  @if (Model.ErrorMessage is not null)
  {
    <div class="alert alert-error" role="alert">@Model.ErrorMessage</div>
  }

  <form method="post" class="panel">
    <div class="field">
      <label for="password">@Text["Password"]</label>
      <input type="password" id="password" name="Password"
             autocomplete="new-password" required
             minlength="@ActivatePasswordModel.MinimumPasswordLength"
             maxlength="@ActivatePasswordModel.MaximumPasswordLength" />
      <p class="hint">
        @Text["At least {0} characters. A short sentence you will remember works well.", ActivatePasswordModel.MinimumPasswordLength]
      </p>
    </div>

    <div class="field">
      <label for="confirmPassword">@Text["Confirm password"]</label>
      <input type="password" id="confirmPassword" name="ConfirmPassword"
             autocomplete="new-password" required
             minlength="@ActivatePasswordModel.MinimumPasswordLength"
             maxlength="@ActivatePasswordModel.MaximumPasswordLength" />
    </div>

    <button type="submit" class="button">@Text["Activate my gift card"]</button>
  </form>
}
