@page "/activate/share/password"
@model ActivateSharePasswordModel
@{
  ViewData["Title"] = Text["Create your password"];
}

@if (!Model.HasActivation)
{
  <h1>@Text["We could not activate this shared value"]</h1>
  <div class="alert alert-error" role="alert">@Model.ErrorMessage</div>
  <a class="button button-secondary" asp-page="/SignIn">@Text["Sign in instead"]</a>
}
else
{
  <h1>@Text["Create your password"]</h1>
  <p class="lead">@Text["This is your first gift card, so choose a password to protect your account."]</p>
  @if (Model.ErrorMessage is not null)
  {
    <div class="alert alert-error" role="alert">@Model.ErrorMessage</div>
  }
  <form method="post" class="panel">
    <div class="field">
      <label asp-for="Password">@Text["Password"]</label>
      <input asp-for="Password" type="password" autocomplete="new-password" required
             minlength="@ActivateSharePasswordModel.MinimumPasswordLength"
             maxlength="@ActivateSharePasswordModel.MaximumPasswordLength" />
      <p class="hint">@Text["At least {0} characters. A short sentence you will remember works well.", ActivateSharePasswordModel.MinimumPasswordLength]</p>
    </div>
    <div class="field">
      <label asp-for="ConfirmPassword">@Text["Confirm password"]</label>
      <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required
             minlength="@ActivateSharePasswordModel.MinimumPasswordLength"
             maxlength="@ActivateSharePasswordModel.MaximumPasswordLength" />
    </div>
    <button type="submit" class="button">@Text["Activate shared value"]</button>
  </form>
}
