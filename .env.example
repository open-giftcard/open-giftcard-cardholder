# Cardholder-owned PostgreSQL database. Never reuse the backend or portal DB.
ConnectionStrings__Cardholder=Host=localhost;Port=5432;Database=giftcard_cardholder;Username=giftcard_cardholder_app;Password=replace-me

# Local Development may use HTTP. Staging/Production require HTTPS.
Backend__BaseUrl=http://127.0.0.1:5143

# Required outside Development: an access-controlled persistent volume shared
# by all replicas of this application.
DataProtection__KeyPath=C:\replace-with-a-durable-protected-path

# Optional: trust exactly one ingress hop, using its literal address only.
# Networking__ForwardedHeaders__KnownProxies__0=127.0.0.1
